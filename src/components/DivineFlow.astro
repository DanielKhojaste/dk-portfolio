---
/**
 * Decorative DivineFlow background. Fills its nearest positioned ancestor.
 * `compactOptions` are merged over `options` while `compactQuery` matches (small or portrait screens).
 */
import type { DivineFlowOptions } from "../lib/divine-flow";

type FlowOptions = Omit<DivineFlowOptions, "canvas">;

interface Props {
	options?: FlowOptions;
	compactOptions?: FlowOptions;
	compactQuery?: string;
	class?: string;
	/**
	 * Wait for the header logo to finish writing before starting, so the two never compete for the
	 * main thread during load. Starts anyway after `startTimeout` ms.
	 */
	afterLogo?: boolean;
	startTimeout?: number;
}

const {
	options = {},
	compactOptions,
	compactQuery = "(max-width: 1023px), (max-aspect-ratio: 115/100)",
	class: className,
	afterLogo = false,
	startTimeout = 2600,
} = Astro.props;
---

<div
	class:list={["divine-flow", className]}
	aria-hidden="true"
	data-divine-flow
	data-options={JSON.stringify(options)}
	data-compact-options={compactOptions ? JSON.stringify(compactOptions) : undefined}
	data-compact-query={compactOptions ? compactQuery : undefined}
	data-after-logo={afterLogo ? "" : undefined}
	data-start-timeout={startTimeout}
>
</div>

<script>
	import { mountDivineFlows } from "../scripts/divine-flow";

	mountDivineFlows();
</script>

<style>
	.divine-flow {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		/* Fades in once started; opacity is compositor-only, so the fade costs nothing per frame. */
		opacity: 0;
		transition: opacity 1.6s var(--ease-out);
	}

	.divine-flow[data-flow-ready] {
		opacity: 1;
	}
</style>
