---
/**
 * Decorative DivineFlow background. Fills its nearest positioned ancestor.
 * `compactOptions` are merged over `options` while `compactQuery` matches (small or portrait screens).
 */
import type { DivineFlowOptions } from "../lib/divine-flow";

type FlowOptions = Omit<DivineFlowOptions, "canvas">;

interface Props {
	options?: FlowOptions;
	compactOptions?: FlowOptions;
	compactQuery?: string;
	class?: string;
	/**
	 * Draw the flow in on load: filaments grow from the origin out to the sides (GSAP, skipped for
	 * reduced motion). `true` uses the defaults (0.2s delay, 2s, power2.out).
	 */
	reveal?: boolean | { delay?: number; duration?: number; ease?: string };
}

const {
	options = {},
	compactOptions,
	compactQuery = "(max-width: 1023px), (max-aspect-ratio: 115/100)",
	class: className,
	reveal = false,
} = Astro.props;
---

<div
	class:list={["divine-flow", className]}
	aria-hidden="true"
	data-divine-flow
	data-options={JSON.stringify(options)}
	data-compact-options={compactOptions ? JSON.stringify(compactOptions) : undefined}
	data-compact-query={compactOptions ? compactQuery : undefined}
	data-reveal={reveal ? JSON.stringify(reveal === true ? {} : reveal) : undefined}
>
</div>

<script>
	import { mountDivineFlows } from "../scripts/divine-flow";

	mountDivineFlows();
</script>

<style>
	.divine-flow {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		/* Fades in once started; opacity is compositor-only, so the fade costs nothing per frame. Flows
		   that draw in only need a short fade, for the origin glow. */
		opacity: 0;
		transition: opacity 1.6s var(--ease-out);
	}

	.divine-flow[data-reveal] {
		transition-duration: 0.5s;
	}

	.divine-flow[data-flow-ready] {
		opacity: 1;
	}
</style>
