---
/**
 * Desktop: the list of sections down the left, in place of the menu button. Labels are outlined;
 * hovering one lights it up white with a glow in the main colour and slides it a little to the right
 * (textHover and sideNav.nudge in site.config.ts), and its marker turns white. The section you're on
 * is filled white, its marker glows in the main colour, and a strand of DivineFlow draws out under it
 * (sideNavUnderlineFlow). Phones and tablets get the menu button instead.
 *
 * It stays out of the way on the hero (the first section) and fades in from About onwards.
 */
import { colors, sections, sideNav, sideNavUnderlineFlow } from "../site.config";
import { underlineHeight, underlineOptions } from "../scripts/underline-options";
import DivineFlow from "./DivineFlow.astro";

const ruleHeight = underlineHeight(sideNavUnderlineFlow);
const underline = underlineOptions(sideNavUnderlineFlow, colors.sideNavUnderline);
---

<nav
	class="side-nav"
	aria-label="Sections"
	style={`--rule-h: ${ruleHeight}px`}
	data-side-nav
	data-on-hero
>
	<ol class="side-nav__list">
		{
			sections.map((section) => (
				<li>
					<a class="side-nav__link" href={section.href} data-side-nav-link={section.href.slice(1)}>
						{sideNav.marker && (
							<span class="side-nav__marker" aria-hidden="true">
								{sideNav.marker}
							</span>
						)}
						<span class="side-nav__text">
							<span class="side-nav__label">{section.label}</span>
							<span class="side-nav__rule" aria-hidden="true">
								<DivineFlow manual fadeIn={0} options={underline} />
							</span>
						</span>
					</a>
				</li>
			))
		}
	</ol>
</nav>

<script>
	import { animation } from "../site.config";
	import { setupSideNav } from "../scripts/side-nav";

	setupSideNav(
		document,
		{
			in: animation.sideNav.underlineIn,
			out: animation.sideNav.underlineOut,
			ease: animation.sideNav.underlineEase,
		},
		animation.sideNav.labelOut,
	);
</script>

<style>
	.side-nav {
		position: fixed;
		left: var(--gutter);
		/* Centred, between the hero's last name and its "Based in" claim (which starts at 64% down). */
		top: 50%;
		translate: 0 -50%;
		z-index: 10;
		display: none;
		transition:
			opacity 0.5s var(--ease-out),
			translate 0.5s var(--ease-out),
			visibility 0s;
	}

	/* Hidden (and out of the tab order) on the hero; slides in once you leave it. */
	.side-nav[data-on-hero] {
		visibility: hidden;
		opacity: 0;
		translate: -12px -50%;
		pointer-events: none;
		transition:
			opacity 0.35s var(--ease-out),
			translate 0.35s var(--ease-out),
			visibility 0s linear 0.35s;
	}

	/* Same breakpoint as --side-nav-w in global.css. */
	@media (min-width: 1024px) and (min-height: 600px) {
		.side-nav {
			display: block;
		}
	}

	.side-nav__list {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.side-nav__link {
		display: flex;
		align-items: center;
		gap: 14px;
		border-radius: 4px;
		color: var(--color-text);
		text-decoration: none;
	}

	.side-nav__marker {
		width: 14px;
		font-size: 13px;
		line-height: 1;
		text-align: center;
		color: rgb(var(--shade-text) / 0.3);
		transition:
			color var(--text-hover-duration) var(--text-hover-ease),
			scale var(--text-hover-duration) var(--text-hover-ease),
			text-shadow var(--text-hover-duration) var(--text-hover-ease);
	}

	.side-nav__link:hover .side-nav__marker,
	.side-nav__link:focus-visible .side-nav__marker {
		color: var(--text-hover-color);
	}

	.side-nav__link[aria-current] .side-nav__marker {
		color: rgb(var(--shade-bright));
		scale: 1.35;
		text-shadow: 0 0 10px rgb(var(--shade-halo) / 0.9);
	}

	.side-nav__text {
		position: relative;
		display: block;
	}

	/* Outlined, in a lighter cut of the display font than the hero's name so small labels stay easy to
	   read. */
	.side-nav__label {
		display: block;
		font-family: var(--font-display);
		font-stretch: 110%;
		font-weight: 700;
		font-size: 15px;
		line-height: 1.2;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: transparent;
		-webkit-text-stroke: 0.8px rgb(var(--shade-text) / 0.7);
		transition:
			color var(--text-hover-duration) var(--text-hover-ease),
			text-shadow var(--text-hover-duration) var(--text-hover-ease),
			translate var(--text-hover-duration) var(--text-hover-ease),
			-webkit-text-stroke-color var(--text-hover-duration) var(--text-hover-ease);
	}

	/* Hover: lights up white with a glow, and slides right. */
	.side-nav__link:hover .side-nav__label,
	.side-nav__link:focus-visible .side-nav__label {
		color: var(--text-hover-color);
		-webkit-text-stroke-color: var(--text-hover-color);
		text-shadow: var(--text-hover-glow);
		translate: var(--side-nav-nudge) 0;
	}

	/* The section you're on: filled white, no glow (its marker and underline mark it). It fills in,
	   and empties again when you leave (data-leaving), at the underline's pace rather than the
	   hover's (animation.sideNav.labelIn / labelOut). */
	.side-nav__link[aria-current] .side-nav__label {
		color: var(--color-text);
		-webkit-text-stroke-color: var(--color-text);
	}

	.side-nav__link[aria-current] :is(.side-nav__label, .side-nav__marker) {
		transition-duration: var(--side-nav-label-in);
		transition-timing-function: var(--side-nav-label-ease);
	}

	.side-nav__link[data-leaving] :is(.side-nav__label, .side-nav__marker) {
		transition-duration: var(--side-nav-label-out);
		transition-timing-function: var(--side-nav-label-ease);
	}

	@supports not (-webkit-text-stroke: 1px) {
		.side-nav__label {
			color: var(--color-text-muted);
		}
		.side-nav__link[aria-current] .side-nav__label {
			color: var(--color-text);
		}
	}

	/* Strip for the underline: a little wider than the word, fading out at both ends. Absolutely
	   placed, so it never pushes the labels apart. */
	.side-nav__rule {
		position: absolute;
		left: -18px;
		right: -18px;
		top: 100%;
		height: var(--rule-h, 30px);
		margin-top: calc(var(--rule-h, 30px) / -2 + 3px);
		pointer-events: none;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
	}
</style>
