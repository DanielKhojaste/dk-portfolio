---
import { profile } from "../site.config";
---

<footer class="site-footer">
	<p>© {new Date().getFullYear()} {profile.fullName}</p>
</footer>

<style>
	.site-footer {
		padding: 32px var(--gutter);
		border-top: 1px solid rgb(var(--shade-text) / 0.08);
		font-size: 13px;
		color: var(--color-text-muted);
		text-align: center;
	}

	.site-footer p {
		margin: 0;
	}
</style>
