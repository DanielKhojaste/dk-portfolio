---
import { Picture } from "astro:assets";
import { throne, throneSizes, throneWidths } from "./hero-image";
import DivineFlow from "./DivineFlow.astro";

import { animation, backgroundFlow, colors, profile } from "../site.config";
---

<section class="hero" id="intro" aria-labelledby="hero-title">
	<div class="hero__glow" aria-hidden="true"></div>

	<DivineFlow
		reveal={animation.background}
		fadeIn={animation.background.fadeIn}
		options={{ theme: colors.background, ...backgroundFlow.desktop }}
		compactOptions={backgroundFlow.compact}
	/>

	<h1 id="hero-title" class="hero__name">
		<span class="hero__first">Daniel</span>
		<span class="hero__last">Khojaste</span>
	</h1>

	<div class="hero__figure">
		<Picture
			src={throne}
			alt="Daniel sitting on a throne made of golf clubs, lit in red"
			formats={["avif", "webp"]}
			fallbackFormat="webp"
			widths={throneWidths}
			sizes={throneSizes}
			loading="eager"
			fetchpriority="high"
			draggable="false"
			class="hero__throne"
		/>
	</div>

	<div class="hero__vignette" aria-hidden="true"></div>

	<div class="hero__info">
		<div class="hero__claim hero__claim--start">
			<p class="hero__kicker">Based in {profile.location}</p>
			<p class="hero__headline">{profile.role}</p>
		</div>
		<div class="hero__claim hero__claim--end">
			<p class="hero__kicker">Currently building</p>
			<a
				class="hero__headline hero__headline--link"
				href={profile.currently.href}
				target="_blank"
				rel="noopener noreferrer"
			>
				{profile.currently.name}<svg
					class="hero__arrow"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.6"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M7 17L17 7"></path>
					<path d="M8 7h9v9"></path>
				</svg>
				<span class="sr-only">(opens in a new tab)</span>
			</a>
		</div>
	</div>

	<div class="hero__actions">
		<a class="button button--primary" href="#work">
			View my work
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12h14"></path>
				<path d="M13 6l6 6-6 6"></path>
			</svg>
		</a>
		<a class="button button--ghost" href="#contact">Get in touch</a>
	</div>
</section>

<style>
	/*
	 * Everything is absolutely placed in a full-viewport stage and sized with container query units
	 * (cqw/cqh), so the composition scales with the hero itself, including when the height floor
	 * kicks in.
	 *
	 * Layering, back to front: glow, DivineFlow (0) → name (1) → throne (2) → vignette (3) → text (4).
	 */
	.hero {
		position: relative;
		isolation: isolate;
		height: 100svh;
		min-height: 600px;
		overflow: hidden;
		container: hero / size;
		background: var(--color-bg);
	}

	.hero__glow {
		position: absolute;
		left: 50%;
		top: 46%;
		z-index: 0;
		width: min(112cqh, 100cqw);
		aspect-ratio: 1;
		translate: -50% -50%;
		border-radius: 50%;
		background: radial-gradient(
			closest-side,
			rgb(var(--shade-hero-glow) / 0.48),
			rgb(var(--shade-hero-glow-edge) / 0.2) 50%,
			rgb(var(--shade-bg) / 0) 100%
		);
		pointer-events: none;
	}

	.hero__name {
		position: absolute;
		inset-inline: 0;
		top: 11.5cqh;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.3cqh;
		margin: 0;
		font-family: var(--font-display);
		font-stretch: 125%;
		line-height: 1;
		text-align: center;
		text-transform: uppercase;
		user-select: none;
	}

	.hero__first {
		font-size: clamp(22px, min(3cqw, 4.9cqh), 60px);
		font-weight: 800;
		letter-spacing: 0.5em;
		text-indent: 0.5em;
		color: var(--color-text);
	}

	/* The last name is a deep red shape behind the throne, so the photo leads. */
	.hero__last {
		font-size: min(12.2cqw, 19.6cqh);
		font-weight: 900;
		letter-spacing: -0.01em;
		color: rgb(var(--shade-name-fill) / 0.5);
	}

	@supports (background-clip: text) or (-webkit-background-clip: text) {
		.hero__last {
			color: transparent;
			-webkit-text-stroke: 1px rgb(var(--shade-name-stroke) / 0.2);
			background: linear-gradient(
				180deg,
				rgb(var(--shade-name-top) / 0.6),
				rgb(var(--shade-name-bottom) / 0.2)
			);
			-webkit-background-clip: text;
			background-clip: text;
		}
	}

	.hero__figure {
		position: absolute;
		left: 50%;
		bottom: 0;
		z-index: 2;
		height: 90cqh;
		aspect-ratio: 723 / 1210;
		translate: -50% 0;
		pointer-events: none;
	}

	.hero__figure :global(picture),
	.hero__figure :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__figure :global(img) {
		object-fit: contain;
		object-position: center bottom;
		-webkit-mask-image: linear-gradient(#000 64%, transparent 98%);
		mask-image: linear-gradient(#000 64%, transparent 98%);
		user-select: none;
	}

	.hero__vignette {
		position: absolute;
		inset: 0;
		z-index: 3;
		background: radial-gradient(
			ellipse 78% 72% at 50% 45%,
			rgb(0 0 0 / 0) 55%,
			rgb(0 0 0 / 0.62) 100%
		);
		pointer-events: none;
	}

	/*
	 * Both claims start on the same line: "Based in" level with "Currently building", and the first
	 * line of each headline level with the other.
	 */
	.hero__info {
		--claim-w: clamp(240px, 25cqw, 380px);

		position: absolute;
		inset-inline: var(--gutter);
		top: 64cqh;
		z-index: 4;
		display: grid;
		grid-template-columns: minmax(0, var(--claim-w)) 1fr minmax(0, var(--claim-w));
		align-items: start;
		pointer-events: none;
	}

	.hero__claim {
		display: flex;
		flex-direction: column;
		gap: 10px;
		grid-column: 1;
		grid-row: 1;
		min-width: 0;
		pointer-events: auto;
	}

	.hero__claim--end {
		grid-column: -2;
		align-items: flex-end;
		text-align: right;
	}

	.hero__kicker {
		margin: 0;
		white-space: nowrap;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-accent-soft);
	}

	/* Big claims: expanded caps in white with a red glow. */
	.hero__headline {
		margin: 0;
		font-family: var(--font-display);
		font-stretch: 125%;
		font-weight: 800;
		font-size: clamp(18px, 1.75cqw, 28px);
		line-height: 1.12;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		text-decoration: none;
		color: #fff;
		text-shadow: 0 0 28px rgb(var(--shade-halo) / 0.6);
	}

	.hero__headline--link {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		border-radius: 4px;
	}

	.hero__arrow {
		width: 0.62em;
		height: 0.62em;
		flex: none;
		color: var(--color-accent-soft);
		transition: translate var(--hover-duration) var(--ease-out);
	}

	.hero__headline--link:hover .hero__arrow,
	.hero__headline--link:focus-visible .hero__arrow {
		translate: 0.08em -0.08em;
	}

	.hero__actions {
		position: absolute;
		inset-inline: 0;
		bottom: 6.2cqh;
		z-index: 4;
		display: flex;
		justify-content: center;
		gap: 14px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		height: 54px;
		padding: 0 28px;
		border-radius: var(--radius-pill);
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color var(--hover-duration) var(--ease-out),
			border-color var(--hover-duration) var(--ease-out),
			transform var(--hover-duration) var(--ease-out);
	}

	.button svg {
		transition: translate var(--hover-duration) var(--ease-out);
	}

	.button:hover svg {
		translate: 3px 0;
	}

	.button--primary {
		background: var(--color-accent);
		color: #fff;
	}

	.button--primary:hover {
		background: rgb(var(--shade-accent-hover));
	}

	.button--ghost {
		border: 1px solid var(--color-line-strong);
		background: rgb(var(--shade-bg) / 0.4);
		color: var(--color-text);
	}

	.button--ghost:hover {
		border-color: rgb(var(--shade-text) / 0.6);
	}

	/* ---------- Compact: phones, tablets and portrait screens ---------- */
	/*
	 * Compact: phones, tablets and portrait screens. Same composition as desktop: name at the top,
	 * throne anchored to the bottom and as large as the screen allows, info and buttons over the
	 * throne's faded lower part. Everything is placed in cq units of the hero (100svh), so the whole
	 * hero fits the visible screen on phones without scrolling. The 480px floor only kicks in for
	 * landscape phones.
	 */
	@media (max-width: 1023px), (max-aspect-ratio: 115/100) {
		.hero {
			--actions-bottom: max(20px, 3.4cqh);
			--actions-height: 52px;

			min-height: 480px;
		}

		.hero__glow {
			top: 48%;
			width: min(160cqw, 95cqh);
		}

		.hero__name {
			top: max(64px, 9cqh);
			gap: 1cqh;
		}

		.hero__first {
			font-size: clamp(16px, min(5.6cqw, 3.2cqh), 44px);
		}

		.hero__last {
			font-size: min(12.1cqw, 7.4cqh);
		}

		.hero__figure {
			height: 82cqh;
			max-width: 100cqw;
		}

		.hero__figure :global(img) {
			-webkit-mask-image: linear-gradient(#000 58%, transparent 94%);
			mask-image: linear-gradient(#000 58%, transparent 94%);
		}

		/* Vignette plus a bottom scrim, so the info and buttons stay readable over the photo. */
		.hero__vignette {
			background:
				linear-gradient(
					to top,
					rgb(var(--shade-bg) / 0.92) 0,
					rgb(var(--shade-bg) / 0.7) calc(var(--actions-bottom) + 150px),
					rgb(var(--shade-bg) / 0) calc(var(--actions-bottom) + 260px)
				),
				radial-gradient(ellipse 95% 70% at 50% 42%, rgb(0 0 0 / 0) 50%, rgb(0 0 0 / 0.6) 100%);
		}

		.hero__info {
			top: auto;
			bottom: calc(var(--actions-bottom) + var(--actions-height) + max(10px, 1.6cqh));
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			column-gap: 16px;
			translate: none;
		}

		.hero__claim {
			gap: 6px;
		}

		.hero__kicker {
			font-size: 9px;
			letter-spacing: 0.16em;
		}

		.hero__headline {
			font-size: clamp(14px, 4.3cqw, 26px);
		}

		.hero__actions {
			inset-inline: var(--gutter);
			bottom: var(--actions-bottom);
			gap: 10px;
		}

		.button {
			flex: 1 1 0;
			max-width: 240px;
			height: var(--actions-height);
			padding: 0 16px;
		}

		.button svg {
			display: none;
		}
	}

	/* Tablets: a touch more room for the text. */
	@media (min-width: 640px) and (max-width: 1023px),
		(min-width: 640px) and (max-aspect-ratio: 115/100) {
		.hero__info {
			grid-template-columns: minmax(0, 340px) 1fr minmax(0, 340px);
		}

		.hero__kicker {
			font-size: 11px;
		}

		.button svg {
			display: block;
		}
	}
</style>
