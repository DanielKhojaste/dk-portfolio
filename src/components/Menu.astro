---
/**
 * Full-screen menu, opened by the header's menu button (scripts/menu.ts). The page behind it is
 * blurred. Hovering or focusing a link draws a wavy strand of DivineFlow under it
 * (scripts/menu-underlines.ts). Clicking anywhere but a link closes it.
 *
 * Open/close animations are CSS transitions on opacity/transform only, so the compositor runs them
 * even when the main thread is busy.
 */
import type { DivineFlowOptions } from "../lib/divine-flow";
import { colors, menuUnderlineFlow, sections } from "../site.config";
import DivineFlow from "./DivineFlow.astro";

const { from, wave, waves, ...strand } = menuUnderlineFlow;

/** Where the strand starts, as DivineFlow's origin and the side(s) it flows towards. */
const origin = {
	center: { originX: 0.5, sides: "both" },
	left: { originX: 0, sides: "right" },
	right: { originX: 1, sides: "left" },
} as const;

/** Room for the wave, its up-and-down drift and the strand's glow. */
const ruleHeight = Math.ceil(Math.abs(wave) + strand.amplitude * 0.35) * 2 + 24;

/** One strand of the background's DivineFlow, drawn out from `from` with a gentle wave. */
const underline = (seed: number): Omit<DivineFlowOptions, "canvas"> => ({
	theme: colors.background,
	...origin[from],
	originY: 0.5,
	innerGap: 0,
	wave,
	wavePeriods: waves,
	fadeFromOrigin: false,
	lineCount: 1,
	scatterCount: 0,
	spread: 0,
	speckCount: 0,
	emberCount: 0,
	revealStagger: 0,
	uniform: true,
	maxDpr: 2,
	seed,
	...strand,
});
---

<div
	class="menu"
	id="site-menu"
	role="dialog"
	aria-modal="true"
	aria-label="Menu"
	data-menu
	style={`--rule-h: ${ruleHeight}px`}
>
	<div class="menu__glow" aria-hidden="true"></div>

	<nav class="menu__nav" aria-label="Sections">
		<ol class="menu__list">
			{
				sections.map((section, i) => (
					<li class="menu__item" style={`--i: ${i}`}>
						<a class="menu__link" href={section.href} data-menu-link>
							<span class="menu__label">{section.label}</span>
							<span class="menu__rule" aria-hidden="true">
								<DivineFlow manual fadeIn={0} options={underline(7100 + i * 97)} />
							</span>
						</a>
					</li>
				))
			}
		</ol>
	</nav>
</div>

<script>
	import { animation } from "../site.config";
	import { setupMenuUnderlines } from "../scripts/menu-underlines";

	setupMenuUnderlines(document, {
		in: animation.menu.underlineIn,
		out: animation.menu.underlineOut,
		ease: animation.menu.underlineEase,
	});
</script>

<style>
	.menu {
		--menu-ease: cubic-bezier(0.22, 1, 0.36, 1);

		position: fixed;
		inset: 0;
		z-index: 9;
		display: flex;
		overflow-y: auto;
		overscroll-behavior: contain;
		/* See-through enough to keep the hero's colour, blurred so nothing behind competes with the links. */
		background: rgb(8 4 5 / 0.62);
		-webkit-backdrop-filter: blur(18px) saturate(1.1);
		backdrop-filter: blur(18px) saturate(1.1);
		cursor: pointer;
		visibility: hidden;
		opacity: 0;
		transition:
			opacity var(--menu-fade) var(--menu-ease),
			visibility 0s linear var(--menu-fade);
	}

	.menu[data-open] {
		visibility: visible;
		opacity: 1;
		transition: opacity var(--menu-fade) var(--menu-ease);
	}

	.menu__glow {
		position: fixed;
		inset: auto -20% -40% auto;
		width: min(90vw, 900px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgb(190 28 40 / 0.28), rgb(8 4 5 / 0));
		pointer-events: none;
	}

	.menu__nav {
		position: relative;
		width: 100%;
		margin: auto;
		padding: clamp(96px, 14vh, 140px) var(--gutter) clamp(40px, 8vh, 80px);
	}

	.menu__list {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(2px, 0.6vh, 8px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Clips the links while they slide up into place, but only top and bottom, so the underline can
	   run out past the ends of the word. */
	.menu__item {
		clip-path: inset(0 -100vw);
	}

	.menu__link {
		display: flex;
		flex-direction: column;
		align-items: center;
		color: var(--color-text);
		text-decoration: none;
		cursor: pointer;
		transform: translateY(105%);
		transition: transform calc(var(--menu-links) * 0.55) var(--menu-ease);
	}

	.menu[data-open] .menu__link {
		transform: none;
		transition: transform var(--menu-links) var(--menu-ease)
			calc(0.12s + var(--i) * var(--menu-link-stagger));
	}

	.menu__link:focus-visible {
		outline: none;
	}

	.menu__label {
		display: block;
		padding-top: 4px;
		font-family: var(--font-display);
		font-stretch: 125%;
		font-weight: 900;
		font-size: clamp(40px, min(7.2vw, 10vh), 104px);
		line-height: 1;
		text-transform: uppercase;
		color: transparent;
		-webkit-text-stroke: clamp(1px, 0.12vw, 2px) var(--color-text);
		transition: color var(--hover-duration) var(--ease-out);
	}

	.menu__link:hover .menu__label,
	.menu__link:focus-visible .menu__label,
	.menu__link:active .menu__label {
		color: var(--color-text);
	}

	@supports not (-webkit-text-stroke: 1px) {
		.menu__label {
			color: var(--color-text);
		}
	}

	/* Strip for the DivineFlow underline: wider than the word, fading out softly at both ends. */
	.menu__rule {
		position: relative;
		display: block;
		width: calc(100% + 80px);
		height: var(--rule-h, 38px);
		margin-top: calc((var(--rule-h, 38px) - 22px) / -2);
		pointer-events: none;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
	}

	@media (max-width: 767px) {
		.menu__label {
			font-size: clamp(36px, 12vw, 64px);
		}
	}
</style>
