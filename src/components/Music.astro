---
/**
 * The Music section, after Background: the songs from MUSIC.md on my GitHub profile, as cards
 * modelled on the README's "Recently played" cards (cover; Spotify mark, label, title, artist,
 * album). Each card is hollow until hovered: an outline in the song's colour, a grey cover and the
 * title in outlined type like the project names. Hovering fills it with the song's colours. Every
 * card links to the song on Spotify. Lines too long for a card slide to show the rest when the card
 * is hovered (scripts/marquee.ts). Copy and songs live in site.config.ts (`music`).
 */
import { Image } from "astro:assets";
import { music } from "../site.config";
import { splitHighlights } from "../scripts/highlights";

const covers = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/music/*.{png,jpg,jpeg,webp}",
	{
		eager: true,
	},
);
const cover = (file: string) => {
	const found = covers[`../assets/music/${file}`];
	if (!found) throw new Error(`Music: no cover src/assets/music/${file}`);
	return found.default;
};

const words = splitHighlights(music.headline);
const headline = music.headline.replace(/[[\]]/g, "");
const rgb = (c: readonly number[]) => c.join(" ");
---

<section
	class="music"
	id="music"
	aria-labelledby="music-title"
	data-music
	data-artist={music.artist}
>
	<div class="music__inner">
		<div class="music__top">
			<div class="music__heading">
				<p class="music__eyebrow">{music.eyebrow}</p>
				<h2 class="music__headline" id="music-title" aria-label={headline}>
					{
						words.map((word) =>
							word.highlight ? (
								<span aria-hidden="true">
									<span class="music__highlight">
										{word.text}
										<span class="music__fill" data-fill>
											{word.text}
										</span>
									</span>
									{word.tail}{" "}
								</span>
							) : (
								<span aria-hidden="true">{word.text} </span>
							),
						)
					}
				</h2>
				<p class="music__text">{music.text}</p>
			</div>
			<p class="music__prompt">
				<span class="music__prompt-hover">{music.prompt.hover}</span>
				<span class="music__prompt-click">{music.prompt.click}</span>
			</p>
		</div>

		<ul class="music__list">
			{
				music.songs.map((song) => (
					<li class="music__item" data-music-card>
						<a
							class="song"
							data-marquee-trigger
							href={song.url}
							target="_blank"
							rel="noopener noreferrer"
							style={`--c-border: ${rgb(song.colors.border)}; --c-dark: ${rgb(song.colors.dark)}; --c-light: ${rgb(song.colors.light)}; --c-artist: ${rgb(song.colors.artist)}`}
						>
							<Image
								class="song__cover"
								src={cover(song.cover)}
								alt=""
								widths={[160, 320]}
								sizes="(max-width: 767px) 26vw, 140px"
								loading="lazy"
								decoding="async"
							/>
							<span class="song__body">
								<span class="song__label" aria-hidden="true">
									<svg class="song__spotify" viewBox="0 0 24 24">
										<circle cx="12" cy="12" r="12" fill="#1ed760" />
										<path
											fill="#000"
											d="M17.5 17.3a.75.75 0 0 1-1 .25c-2.86-1.75-6.46-2.14-10.7-1.17a.75.75 0 1 1-.33-1.46c4.64-1.06 8.62-.6 11.8 1.35.36.22.47.68.25 1.03Zm1.47-3.27a.94.94 0 0 1-1.29.31c-3.27-2-8.26-2.6-12.13-1.42a.94.94 0 1 1-.55-1.8c4.42-1.34 9.92-.69 13.66 1.62.44.27.58.85.31 1.29Zm.13-3.4C15.18 8.3 8.73 8.08 5 9.22a1.13 1.13 0 1 1-.66-2.16c4.28-1.3 11.4-1.05 15.9 1.62a1.13 1.13 0 0 1-1.15 1.95Z"
										/>
									</svg>
									{music.label}
								</span>
								<span class="song__title" data-marquee>
									<span>{song.title}</span>
								</span>
								<span class="song__artist" data-marquee>
									<span>{song.artist}</span>
								</span>
								<span class="song__album" data-marquee>
									<span>{song.album}</span>
								</span>
								<span class="sr-only">on Spotify (opens in a new tab)</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { animation } from "../site.config";
	import { FILL_EMPTY, FILL_FULL } from "../scripts/about";
	import { setupMarquee } from "../scripts/marquee";

	gsap.registerPlugin(ScrollTrigger);

	const section = document.querySelector<HTMLElement>("[data-music]");
	if (section) {
		const timing = animation.music;
		const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
		setupMarquee(section, timing.marquee, { reducedMotion });

		if (!reducedMotion) {
			// On arrival: the headline's red word wipes in and the cards rise in, like Background.
			const fills = section.querySelectorAll<HTMLElement>("[data-fill]");
			const cards = section.querySelectorAll<HTMLElement>("[data-music-card]");
			gsap.set(fills, { clipPath: FILL_EMPTY });
			gsap.set(cards, { opacity: 0, y: 30 });
			ScrollTrigger.create({
				trigger: section,
				start: "top 75%",
				once: true,
				onEnter: () => {
					gsap.to(fills, {
						clipPath: FILL_FULL,
						duration: timing.highlight,
						delay: 0.2,
						ease: "power3.inOut",
					});
					gsap.to(cards, {
						opacity: 1,
						y: 0,
						duration: timing.rows,
						stagger: timing.rowStagger,
						delay: 0.15,
						ease: "power3.out",
						clearProps: "transform",
					});
				},
			});
		}
	}
</script>

<style>
	.music {
		display: flex;
		align-items: flex-start;
		min-height: 100svh;
		padding: clamp(110px, 20vh, 200px) var(--gutter) clamp(40px, 8vh, 80px) var(--content-left);
	}

	.music__inner {
		width: 100%;
		max-width: 1180px;
	}

	.music__top {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 32px;
		margin-bottom: clamp(28px, 5vh, 56px);
	}

	.music__heading {
		display: flex;
		flex-direction: column;
		gap: clamp(14px, 2.4vh, 22px);
	}

	.music__eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-accent-soft);
	}

	.music__headline {
		margin: 0;
		font-family: var(--font-display);
		font-stretch: 125%;
		font-weight: 800;
		font-size: clamp(28px, 3.6vw, 60px);
		line-height: 1.04;
		text-transform: uppercase;
		color: #fff;
	}

	/* The red word: outlined, with a solid copy on top wiped in on arrival (like Background's). */
	.music__highlight {
		position: relative;
		display: inline-block;
		color: transparent;
		-webkit-text-stroke: clamp(1px, 0.1vw, 1.6px) rgb(var(--shade-bright));
	}

	.music__fill {
		position: absolute;
		inset: 0;
		white-space: nowrap;
		color: rgb(var(--shade-bright));
		text-shadow:
			0 0 22px rgb(var(--shade-halo) / 0.55),
			0 0 4px rgb(var(--shade-bright) / 0.35);
		clip-path: inset(-30% -8% -30% -8%);
	}

	@supports not (-webkit-text-stroke: 1px) {
		.music__highlight {
			color: rgb(var(--shade-bright));
		}
	}

	.music__text {
		margin: 0;
		max-width: 46ch;
		font-size: 15px;
		line-height: 1.55;
		color: var(--color-text-soft);
	}

	.music__prompt {
		margin: 0;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.music__prompt-click {
		display: none;
	}

	@media not ((hover: hover) and (pointer: fine)) {
		.music__prompt-hover {
			display: none;
		}

		.music__prompt-click {
			display: inline;
		}
	}

	.music__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(14px, 1.6vw, 22px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.music__item {
		display: flex;
	}

	/* A card, sized from its own width (cqi), like the README cards: cover | label, title, artist,
	   album. Hollow until hovered or focused. */
	.song {
		container-type: inline-size;
		position: relative;
		display: grid;
		grid-template-columns: 26% minmax(0, 1fr);
		align-items: center;
		gap: 5%;
		width: 100%;
		padding: 3.4% 4% 3.4% 3.4%;
		border: 2px solid rgb(var(--c-border) / 0.35);
		border-radius: 16px;
		color: inherit;
		text-decoration: none;
		background: transparent;
		isolation: isolate;
		transition:
			background-color var(--text-hover-duration) var(--text-hover-ease),
			border-color var(--text-hover-duration) var(--text-hover-ease),
			box-shadow var(--text-hover-duration) var(--text-hover-ease);
	}

	/* The song's colours, faded in under the hollow card (a gradient can't transition itself). */
	.song::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		background:
			radial-gradient(120% 140% at 100% 100%, rgb(var(--c-light) / 0.9), transparent 60%),
			linear-gradient(
				160deg,
				rgb(var(--c-dark)),
				rgb(var(--c-dark)) 40%,
				rgb(var(--c-light) / 0.75)
			);
		opacity: 0;
		transition: opacity var(--text-hover-duration) var(--text-hover-ease);
	}

	.song__cover {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid rgb(var(--c-border) / 0.5);
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
		filter: grayscale(1) brightness(0.55);
		transition: filter var(--text-hover-duration) var(--text-hover-ease);
	}

	.song__body {
		display: flex;
		flex-direction: column;
		gap: max(4px, 1.4cqi);
		min-width: 0;
	}

	.song__label {
		display: flex;
		align-items: center;
		gap: 3cqi;
		font-size: clamp(9px, 2.6cqi, 15px);
		font-weight: 500;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		transition: color var(--text-hover-duration) var(--text-hover-ease);
	}

	.song__spotify {
		flex: none;
		width: clamp(16px, 5.2cqi, 32px);
		height: clamp(16px, 5.2cqi, 32px);
		filter: grayscale(1) opacity(0.6);
		transition: filter var(--text-hover-duration) var(--text-hover-ease);
	}

	/* Outlined like the project names until the card is hovered, then solid white. */
	.song__title {
		margin-top: 1cqi;
		font-family: var(--font-display);
		font-stretch: 125%;
		font-weight: 900;
		font-size: clamp(16px, 5.2cqi, 34px);
		line-height: 1.1;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: transparent;
		-webkit-text-stroke: 1.1px rgb(var(--shade-text) / 0.5);
		transition:
			color var(--text-hover-duration) var(--text-hover-ease),
			-webkit-text-stroke-color var(--text-hover-duration) var(--text-hover-ease);
	}

	@supports not (-webkit-text-stroke: 1px) {
		.song__title {
			color: var(--color-text-muted);
		}
	}

	.song__artist {
		font-size: clamp(12px, 3.4cqi, 22px);
		font-weight: 700;
		color: rgb(var(--c-artist));
		transition: color var(--text-hover-duration) var(--text-hover-ease);
	}

	/* music.artist: "quiet" keeps the artist grey until the card is hovered. */
	.music[data-artist="quiet"] .song__artist {
		color: var(--color-text-soft);
	}

	.song__album {
		font-size: clamp(11px, 2.9cqi, 18px);
		color: var(--color-text-muted);
		transition: color var(--text-hover-duration) var(--text-hover-ease);
	}

	/* Hovered or focused: the README card in full. */
	.song:hover,
	.song:focus-visible {
		border-color: rgb(var(--c-border));
		box-shadow:
			0 20px 50px rgb(0 0 0 / 0.55),
			0 0 40px rgb(var(--c-border) / 0.25);
	}

	.song:hover::before,
	.song:focus-visible::before {
		opacity: 1;
	}

	.song:hover .song__cover,
	.song:focus-visible .song__cover,
	.song:hover .song__spotify,
	.song:focus-visible .song__spotify {
		filter: none;
	}

	.song:hover .song__title,
	.song:focus-visible .song__title {
		color: #fff;
		-webkit-text-stroke-color: #fff;
	}

	.song:hover .song__label,
	.song:focus-visible .song__label {
		color: rgb(var(--c-artist) / 0.85);
	}

	.music .song:hover .song__artist,
	.music .song:focus-visible .song__artist {
		color: rgb(var(--c-artist));
	}

	.song:hover .song__album,
	.song:focus-visible .song__album {
		color: rgb(var(--c-artist) / 0.65);
	}

	.song:focus-visible {
		outline: 2px solid rgb(var(--shade-bright));
		outline-offset: 3px;
	}

	/* A line too long for the card: one line, sliding to show the rest (scripts/marquee.ts), with a
	   fade at its right edge while it moves. */
	[data-marquee] {
		display: block;
		overflow: hidden;
		white-space: nowrap;
		padding-inline: 2px;
		margin-inline: -2px;
	}

	[data-marquee] > span {
		display: inline-block;
	}

	[data-marquee]:global(.is-overflowing) {
		-webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 16px), transparent);
		mask-image: linear-gradient(90deg, #000 calc(100% - 16px), transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-marquee] {
			text-overflow: ellipsis;
		}

		[data-marquee] > span {
			display: inline;
		}
	}

	@media (max-width: 767px) {
		.music__top {
			flex-direction: column;
			align-items: flex-start;
			gap: 18px;
		}

		.music__prompt {
			white-space: normal;
			line-height: 1.7;
		}

		.music__list {
			grid-template-columns: minmax(0, 1fr);
		}

		/* At phone sizes the heavy display type plus its outline closes up the letters once it fills
		   in, so the filled title drops the outline, a step of weight and opens up a little. */
		.song:hover .song__title,
		.song:focus-visible .song__title {
			-webkit-text-stroke-width: 0;
			font-weight: 800;
			letter-spacing: 0.04em;
		}
	}
</style>
