---
/** A content section, one screen tall: a display heading and slotted content. */
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
	<div class="section__inner">
		<header class="section__header">
			<h2 class="section__title" id={`${id}-title`}>{title}</h2>
		</header>
		<div class="section__body">
			<slot />
		</div>
	</div>
</section>

<style>
	.section {
		display: flex;
		align-items: center;
		min-height: 100svh;
		padding-block: clamp(96px, 13vh, 130px) clamp(40px, 8vh, 80px);
	}

	.section__inner {
		display: grid;
		/* The title's column is at least as wide as the title, so the text never runs under it. */
		grid-template-columns: minmax(max-content, 1fr) minmax(0, 2fr);
		gap: clamp(24px, 5vw, 80px);
		width: 100%;
		max-width: calc(1280px + var(--side-nav-w));
		margin-inline: auto;
		padding-inline: var(--content-left) var(--gutter);
	}

	.section__title {
		margin: 0;
		font-family: var(--font-display);
		font-stretch: 125%;
		font-weight: 900;
		font-size: clamp(32px, 4.2vw, 56px);
		line-height: 1;
		text-transform: uppercase;
	}

	.section__body {
		display: flex;
		flex-direction: column;
		gap: 20px;
		font-size: 17px;
		line-height: 1.7;
		color: var(--color-text-soft);
	}

	.section__body :global(p) {
		margin: 0;
		max-width: 68ch;
	}

	@media (max-width: 767px) {
		.section__inner {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
