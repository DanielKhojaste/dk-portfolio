---
import Logo from "./Logo.astro";
import Menu from "./Menu.astro";
import LogoUnderline from "./LogoUnderline.astro";
import { animation } from "../site.config";

const underline = animation.logoUnderline.style !== "off";
---

<header class="site-header">
	<a
		class="site-header__home"
		href="/"
		aria-label="Daniel Khojaste, home"
		data-underline={underline ? "" : undefined}
	>
		<span class="site-header__mark">
			<Logo draw />
			<LogoUnderline />
		</span>
	</a>

	<button
		class="menu-button"
		type="button"
		aria-label="Open menu"
		aria-expanded="false"
		aria-controls="site-menu"
		data-menu-button
	>
		<span class="menu-button__label" aria-hidden="true">
			<span class="menu-button__word menu-button__word--open">Menu</span>
			<span class="menu-button__word menu-button__word--close">Close</span>
		</span>
		<span class="menu-button__icon" aria-hidden="true">
			<svg
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.4"
				stroke-linecap="round"
			>
				<path d="M4 8h16"></path>
				<path d="M4 16h16"></path>
			</svg>
		</span>
	</button>
</header>

<Menu />

<script>
	import { animation } from "../site.config";
	import { drawLogos } from "../scripts/logo-draw";
	import { setupMenu } from "../scripts/menu";

	drawLogos(document, animation.logo);
	setupMenu();
</script>

<style>
	/* Fixed, so the menu button stays reachable however far down the page you are. The bar itself
	   lets clicks through; only the logo and the button take them. */
	.site-header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		pointer-events: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: clamp(14px, 3.5vh, 32px) var(--gutter) 0;
	}

	.site-header__home,
	.menu-button {
		pointer-events: auto;
	}

	/* Hover: a brush stroke is written under the logo (LogoUnderline, animation.logoUnderline). With
	   the underline off, the logo glows in the main colour instead; it never grows. Colour, glow and
	   timing come from site.config.ts (colors.logoHover, animation.logoHover) via BaseLayout. */
	.site-header__home {
		display: flex;
		align-items: center;
		height: 48px;
		padding-block: 5px;
		color: var(--color-text);
		transition:
			color var(--logo-hover-duration) var(--logo-hover-ease),
			filter var(--logo-hover-duration) var(--logo-hover-ease);
	}

	.site-header__mark {
		position: relative;
		display: block;
		height: 100%;
	}

	.site-header__home:not([data-underline]):is(:hover, :focus-visible) {
		color: var(--logo-hover-color);
		filter: drop-shadow(0 0 var(--logo-hover-glow-size) var(--logo-hover-glow))
			drop-shadow(0 0 3px var(--logo-hover-core));
	}

	.menu-button {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		height: 48px;
		padding: 0 6px 0 18px;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-pill);
		background: rgb(var(--shade-bg) / 0.55);
		color: var(--color-text);
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition:
			border-color var(--hover-duration) var(--ease-out),
			background-color var(--hover-duration) var(--ease-out);
	}

	/* Desktop has the side nav instead (same breakpoint as components/SideNav.astro). */
	@media (min-width: 1024px) and (min-height: 600px) {
		.menu-button {
			display: none;
		}
	}

	.menu-button:hover {
		border-color: var(--color-line-strong);
		background: rgb(var(--shade-text) / 0.06);
	}

	/* "Menu" and "Close" share one cell so swapping them never changes the button's width. */
	.menu-button__label {
		display: grid;
		overflow: hidden;
	}

	.menu-button__word {
		grid-area: 1 / 1;
		text-align: right;
		transition:
			transform var(--menu-button-duration) var(--ease-out),
			opacity var(--menu-button-duration) var(--ease-out);
	}

	.menu-button__word--close {
		opacity: 0;
		transform: translateY(100%);
	}

	.menu-button[aria-expanded="true"] .menu-button__word--open {
		opacity: 0;
		transform: translateY(-100%);
	}

	.menu-button[aria-expanded="true"] .menu-button__word--close {
		opacity: 1;
		transform: none;
	}

	.menu-button__icon {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--color-text);
		color: var(--color-bg);
		transition: transform calc(var(--hover-duration) * 1.5) var(--ease-out);
	}

	.menu-button:hover .menu-button__icon {
		transform: rotate(90deg);
	}

	/* The two bars fold into an X around the icon's centre. */
	.menu-button__icon path {
		transform-box: view-box;
		transform-origin: 12px 12px;
		transition: transform var(--menu-button-duration) var(--ease-out);
	}

	.menu-button[aria-expanded="true"] .menu-button__icon path:first-child {
		transform: rotate(45deg) translateY(4px);
	}

	.menu-button[aria-expanded="true"] .menu-button__icon path:last-child {
		transform: rotate(-45deg) translateY(-4px);
	}

	@media (max-width: 1023px), (max-aspect-ratio: 115/100) {
		.site-header__home {
			height: 44px;
			padding-block: 6px;
		}

		.menu-button {
			width: 44px;
			height: 44px;
			padding: 0;
			justify-content: center;
			border: 0;
			background: var(--color-text);
		}

		.menu-button__label {
			display: none;
		}

		.menu-button__icon {
			width: 44px;
			height: 44px;
		}
	}
</style>
