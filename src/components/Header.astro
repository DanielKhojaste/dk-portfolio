---
import Logo from "./Logo.astro";
import Menu from "./Menu.astro";
---

<header class="site-header">
	<a class="site-header__home" href="/" aria-label="Daniel Khojaste, home">
		<Logo draw />
	</a>

	<button
		class="menu-button"
		type="button"
		aria-label="Open menu"
		aria-expanded="false"
		aria-controls="site-menu"
		data-menu-button
	>
		<span class="menu-button__label" aria-hidden="true">
			<span class="menu-button__word menu-button__word--open">Menu</span>
			<span class="menu-button__word menu-button__word--close">Close</span>
		</span>
		<span class="menu-button__icon" aria-hidden="true">
			<svg
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.4"
				stroke-linecap="round"
			>
				<path d="M4 8h16"></path>
				<path d="M4 16h16"></path>
			</svg>
		</span>
	</button>
</header>

<Menu />

<script>
	import { drawLogos } from "../scripts/logo-draw";
	import { setupMenu } from "../scripts/menu";

	drawLogos();
	setupMenu();
</script>

<style>
	.site-header {
		position: absolute;
		inset: 0 0 auto;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: clamp(14px, 3.5vh, 32px) var(--gutter) 0;
	}

	/* Keep the close button on screen when the menu is opened from further down the page. */
	:global(html[data-menu-open]) .site-header {
		position: fixed;
	}

	.site-header__home {
		display: flex;
		align-items: center;
		height: 48px;
		padding-block: 5px;
		color: var(--color-text);
	}

	.menu-button {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		height: 48px;
		padding: 0 6px 0 18px;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-pill);
		background: rgb(8 4 5 / 0.55);
		color: var(--color-text);
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition:
			border-color 0.2s var(--ease-out),
			background-color 0.2s var(--ease-out);
	}

	.menu-button:hover {
		border-color: var(--color-line-strong);
		background: rgb(245 236 236 / 0.06);
	}

	/* "Menu" and "Close" share one cell so swapping them never changes the button's width. */
	.menu-button__label {
		display: grid;
		overflow: hidden;
	}

	.menu-button__word {
		grid-area: 1 / 1;
		text-align: right;
		transition:
			transform 0.4s var(--ease-out),
			opacity 0.4s var(--ease-out);
	}

	.menu-button__word--close {
		opacity: 0;
		transform: translateY(100%);
	}

	.menu-button[aria-expanded="true"] .menu-button__word--open {
		opacity: 0;
		transform: translateY(-100%);
	}

	.menu-button[aria-expanded="true"] .menu-button__word--close {
		opacity: 1;
		transform: none;
	}

	.menu-button__icon {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--color-text);
		color: var(--color-bg);
		transition: transform 0.3s var(--ease-out);
	}

	.menu-button:hover .menu-button__icon {
		transform: rotate(90deg);
	}

	/* The two bars fold into an X around the icon's centre. */
	.menu-button__icon path {
		transform-box: view-box;
		transform-origin: 12px 12px;
		transition: transform 0.4s var(--ease-out);
	}

	.menu-button[aria-expanded="true"] .menu-button__icon path:first-child {
		transform: rotate(45deg) translateY(4px);
	}

	.menu-button[aria-expanded="true"] .menu-button__icon path:last-child {
		transform: rotate(-45deg) translateY(-4px);
	}

	@media (max-width: 1023px), (max-aspect-ratio: 115/100) {
		.site-header__home {
			height: 44px;
			padding-block: 6px;
		}

		.menu-button {
			width: 44px;
			height: 44px;
			padding: 0;
			justify-content: center;
			border: 0;
			background: var(--color-text);
		}

		.menu-button__label {
			display: none;
		}

		.menu-button__icon {
			width: 44px;
			height: 44px;
		}
	}
</style>
