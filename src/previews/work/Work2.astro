---
/** Design 2 · Featured + grid: one big card for Lineup, two smaller ones beside it. */
import Head from "./Head.astro";
import Shot from "./Shot.astro";
import { projects, work } from "./projects";

const [lead, ...rest] = projects;
---

<section class="w2" id="work" aria-labelledby="work-title">
	<div class="w2__inner">
		<div class="w2__top">
			<Head eyebrow={work.eyebrow} headline="Things I've [built]" />
			<p class="w2__intro">A desktop app for coaches, a brand site and an extension for VS Code.</p>
		</div>

		<ul class="w2__grid" data-w2-grid>
			<li class="w2__card w2__card--lead">
				<a href={lead.link.href} target="_blank" rel="noopener noreferrer" class="w2__link">
					<div class="w2__media"><Shot project={lead} /></div>
					<div class="w2__body">
						<p class="w2__meta">
							<span>{lead.kind}</span><span class="w2__status">{lead.status}</span>
						</p>
						<h3 class="w2__name">
							{lead.name}
							<svg class="w2__arrow" viewBox="0 0 24 24" aria-hidden="true"
								><path d="M7 17L17 7M8 7h9v9"></path></svg
							>
						</h3>
						<p class="w2__blurb">{lead.blurb}</p>
						<ul class="w2__stack">
							{lead.stack.map((s) => <li>{s}</li>)}
						</ul>
					</div>
				</a>
			</li>
			{
				rest.map((p) => (
					<li class="w2__card">
						<a href={p.link.href} target="_blank" rel="noopener noreferrer" class="w2__link">
							<div class="w2__media">
								<Shot project={p} />
							</div>
							<div class="w2__body">
								<p class="w2__meta">
									<span>{p.kind}</span>
									<span class="w2__status">{p.status}</span>
								</p>
								<h3 class="w2__name">
									{p.name}
									<svg class="w2__arrow" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M7 17L17 7M8 7h9v9" />
									</svg>
								</h3>
								<p class="w2__short">{p.short}</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);
	const grid = document.querySelector("[data-w2-grid]");
	if (grid && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		gsap.from(grid.children, {
			opacity: 0,
			y: 40,
			duration: 0.9,
			stagger: 0.12,
			ease: "power3.out",
			scrollTrigger: { trigger: grid, start: "top 80%", once: true },
		});
	}
</script>

<style>
	.w2 {
		display: flex;
		align-items: center;
		min-height: 100svh;
		padding: clamp(96px, 13vh, 130px) var(--gutter) clamp(40px, 8vh, 80px) var(--content-left);
	}

	.w2__inner {
		width: 100%;
		max-width: 1180px;
	}

	.w2__top {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 32px;
		margin-bottom: clamp(22px, 4vh, 40px);
	}

	.w2__intro {
		max-width: 36ch;
		margin: 0;
		font-size: 15px;
		line-height: 1.65;
		color: var(--color-text-soft);
	}

	/* A fixed height, so the section fits one screen: pictures take whatever room the text leaves. */
	.w2__grid {
		display: grid;
		grid-template-columns: 1.45fr 1fr;
		grid-template-rows: 1fr 1fr;
		height: clamp(460px, 62vh, 620px);
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.w2__card {
		border-radius: 14px;
		background: rgb(var(--shade-text) / 0.025);
		border: 1px solid rgb(var(--shade-text) / 0.09);
		overflow: hidden;
		transition:
			border-color var(--motion-hover) var(--ease-out),
			box-shadow var(--motion-hover) var(--ease-out),
			translate var(--motion-hover) var(--ease-out);
	}

	.w2__card:hover {
		translate: 0 -4px;
		border-color: rgb(var(--shade-bright) / 0.45);
		box-shadow:
			0 24px 60px rgb(0 0 0 / 0.5),
			0 0 40px rgb(var(--shade-halo) / 0.16);
	}

	.w2__card--lead {
		grid-row: 1 / span 2;
	}

	.w2__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.w2__media {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		border-bottom: 1px solid rgb(var(--shade-text) / 0.07);
	}

	.w2__media :global(.viz) {
		transition: scale 0.8s var(--ease-out);
	}

	.w2__card:hover .w2__media :global(.viz) {
		scale: 1.04;
	}

	.w2__body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px 18px 18px;
	}

	.w2__card--lead .w2__body {
		gap: 12px;
		padding: 22px 24px 24px;
	}

	.w2__meta {
		display: flex;
		gap: 12px;
		margin: 0;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.w2__status {
		color: var(--color-accent-soft);
	}

	.w2__name {
		display: flex;
		align-items: center;
		gap: 0.35em;
		margin: 0;
		font-family: var(--font-display);
		font-stretch: 125%;
		font-weight: 800;
		font-size: 20px;
		text-transform: uppercase;
		color: #fff;
	}

	.w2__card--lead .w2__name {
		font-size: clamp(26px, 2.6vw, 38px);
	}

	.w2__arrow {
		width: 0.6em;
		height: 0.6em;
		fill: none;
		stroke: var(--color-accent-soft);
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate var(--motion-hover) var(--ease-out);
	}

	.w2__card:hover .w2__arrow {
		translate: 0.08em -0.08em;
	}

	.w2__blurb {
		margin: 0;
		max-width: 52ch;
		font-size: 15px;
		line-height: 1.65;
		color: var(--color-text-soft);
	}

	.w2__short {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-text-soft);
	}

	.w2__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 4px 0 0;
		padding: 0;
		list-style: none;
	}

	.w2__stack li {
		padding: 5px 10px;
		border-radius: 999px;
		font-size: 12px;
		color: var(--color-text-soft);
		border: 1px solid rgb(var(--shade-text) / 0.12);
	}

	@media (max-width: 1100px) {
		.w2__grid {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: none;
			height: auto;
		}

		.w2__media {
			flex: none;
			aspect-ratio: 16 / 9;
		}
		.w2__card--lead {
			grid-row: auto;
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 767px) {
		.w2__top {
			flex-direction: column;
			align-items: flex-start;
			gap: 14px;
		}
		.w2__grid {
			grid-template-columns: 1fr;
			grid-template-rows: none;
			height: auto;
		}

		.w2__media {
			flex: none;
			aspect-ratio: 16 / 9;
		}
		.w2__blurb {
			font-size: 14px;
		}
	}
</style>
