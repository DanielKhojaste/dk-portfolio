---
/** Eyebrow + headline for a mockup section. [bracketed] words are outlined red and wipe in solid on arrival, like About. */
interface Props {
	eyebrow: string;
	headline: string;
	class?: string;
	size?: "lg" | "md";
}
const { eyebrow, headline, class: className, size = "lg" } = Astro.props;
const parts = headline.split(/(\[[^\]]+\])/).filter(Boolean);
const plain = headline.replace(/[[\]]/g, "");
---

<header class:list={["mhead", `mhead--${size}`, className]} data-mhead>
	<p class="mhead__eyebrow">{eyebrow}</p>
	<h2 class="mhead__title" aria-label={plain}>
		{
			parts.map((p) =>
				p.startsWith("[") ? (
					<span class="mhead__hl" aria-hidden="true">
						{p.slice(1, -1)}
						<span class="mhead__fill" data-mfill>
							{p.slice(1, -1)}
						</span>
					</span>
				) : (
					<span aria-hidden="true">{p}</span>
				),
			)
		}
	</h2>
</header>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);
	const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
	document.querySelectorAll<HTMLElement>("[data-mhead]").forEach((head) => {
		const fills = head.querySelectorAll("[data-mfill]");
		if (reduced || !fills.length) return;
		gsap.set(fills, { clipPath: "inset(-30% 108% -30% -8%)" });
		ScrollTrigger.create({
			trigger: head,
			start: "top 75%",
			once: true,
			onEnter: () =>
				gsap.to(fills, {
					clipPath: "inset(-30% -8% -30% -8%)",
					duration: 0.9,
					stagger: 1.1,
					delay: 0.2,
					ease: "power3.inOut",
				}),
		});
	});
</script>

<style>
	.mhead {
		display: flex;
		flex-direction: column;
		gap: clamp(14px, 2.4vh, 22px);
	}

	.mhead__eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-accent-soft);
	}

	.mhead__title {
		margin: 0;
		font-family: var(--font-display);
		font-stretch: 125%;
		font-weight: 800;
		line-height: 1.04;
		text-transform: uppercase;
		color: #fff;
	}

	.mhead--lg .mhead__title {
		font-size: clamp(28px, 3.6vw, 60px);
	}

	.mhead--md .mhead__title {
		font-size: clamp(24px, 2.7vw, 42px);
	}

	.mhead__hl {
		position: relative;
		color: transparent;
		-webkit-text-stroke: clamp(1px, 0.1vw, 1.6px) rgb(var(--shade-bright));
	}

	.mhead__fill {
		position: absolute;
		inset: 0;
		white-space: nowrap;
		color: rgb(var(--shade-bright));
		text-shadow:
			0 0 22px rgb(var(--shade-halo) / 0.55),
			0 0 4px rgb(var(--shade-bright) / 0.35);
		clip-path: inset(-30% -8% -30% -8%);
	}

	@media (max-width: 767px) {
		.mhead--lg .mhead__title,
		.mhead--md .mhead__title {
			font-size: clamp(24px, 7.4vw, 32px);
		}
	}
</style>
