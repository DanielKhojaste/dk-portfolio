---
/**
 * Preview (preview/hiring only): try the Contact section without the "Hiring?" card, and the
 * places that could say "I'm looking for a full-time role" instead. Each switch is independent,
 * so they can be combined. Kept in the address (?hiring=…&line=…&fact=…&badge=…).
 */
const switches = [
	{ key: "hiring", label: '"Hiring?" card in Contact', on: false },
	{ key: "line", label: "Line under the Contact headline", on: true },
	{ key: "fact", label: '"Open to" fact in About', on: true },
	{ key: "badge", label: "Badge at the top of the hero", on: false },
];
---

<aside class="pvh" aria-label="Hiring preview">
	<p class="pvh__title">Hiring preview</p>
	{
		switches.map((s) => (
			<label class="pvh__row">
				<input type="checkbox" data-pv-switch={s.key} checked={s.on} />
				<span>{s.label}</span>
			</label>
		))
	}
	<div class="pvh__go">
		<a href="#intro">Hero</a>
		<a href="#about">About</a>
		<a href="#contact">Contact</a>
	</div>
</aside>

<script>
	const root = document.documentElement;
	const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-pv-switch]")];
	const url = new URL(location.href);
	const apply = () => {
		for (const box of boxes) {
			root.toggleAttribute(`data-pv-${box.dataset.pvSwitch}`, box.checked);
			url.searchParams.set(box.dataset.pvSwitch!, box.checked ? "1" : "0");
		}
		history.replaceState(null, "", url);
	};
	for (const box of boxes) {
		const fromUrl = url.searchParams.get(box.dataset.pvSwitch!);
		if (fromUrl !== null) box.checked = fromUrl === "1";
		box.addEventListener("change", apply);
	}
	apply();
</script>

<style is:global>
	/* ---------- What each switch shows or hides ---------- */
	html:not([data-pv-hiring]) .pv-hiring-card {
		display: none;
	}

	html:not([data-pv-hiring]) .contact__paths {
		grid-template-columns: minmax(0, 1fr);
	}

	/* Without the Hiring card, "Two ways to work together" no longer fits: "Let's work together". */
	.pv-alt-headline {
		display: none;
	}

	html:not([data-pv-hiring]) #contact-title {
		display: none;
	}

	html:not([data-pv-hiring]) .pv-alt-headline {
		display: block;
	}

	html:not([data-pv-hiring]) .pv-alt-headline .contact__fill {
		clip-path: inset(-30% -8% -30% -8%) !important;
	}

	html:not([data-pv-line]) .pv-contact-line,
	html:not([data-pv-fact]) .pv-about-fact,
	html:not([data-pv-badge]) .pv-hero-badge {
		display: none;
	}

	html[data-pv-fact] .about__facts {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	@media (max-width: 767px) {
		html[data-pv-fact] .about__facts {
			grid-template-columns: 1fr;
		}
	}

	/* ---------- The new pieces ---------- */
	.pv-dot {
		position: relative;
		display: inline-block;
		flex: none;
		width: 8px;
		height: 8px;
		margin-right: 10px;
		border-radius: 50%;
		background: rgb(var(--shade-bright));
		box-shadow: 0 0 10px rgb(var(--shade-halo));
		vertical-align: 0.1em;
	}

	.pv-dot::after {
		content: "";
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		border: 1px solid rgb(var(--shade-bright) / 0.6);
		animation: pv-pulse 2.2s var(--ease-out) infinite;
	}

	@keyframes pv-pulse {
		from {
			opacity: 1;
			scale: 0.6;
		}
		to {
			opacity: 0;
			scale: 1.8;
		}
	}

	.contact__intro {
		max-width: 62ch;
		margin: 6px 0 0;
		font-size: clamp(15px, 1.2vw, 18px);
		line-height: 1.55;
		color: var(--color-text-soft);
	}

	.pv-hero-badge {
		position: absolute;
		top: clamp(26px, 4vh, 40px);
		left: 50%;
		z-index: 5;
		translate: -50% 0;
		display: inline-flex;
		align-items: center;
		margin: 0;
		padding: 8px 16px;
		border-radius: 999px;
		border: 1px solid rgb(var(--shade-bright) / 0.35);
		background: rgb(10 5 6 / 0.55);
		backdrop-filter: blur(6px);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--color-text);
	}

	@media (max-width: 767px) {
		.pv-hero-badge {
			font-size: 9.5px;
			letter-spacing: 0.16em;
			padding: 7px 12px;
		}
	}

	/* ---------- The panel ---------- */
	.pvh {
		position: fixed;
		right: 16px;
		bottom: 16px;
		z-index: 100;
		width: min(290px, calc(100vw - 32px));
		padding: 10px 12px 12px;
		border-radius: 12px;
		border: 1px solid rgb(var(--shade-text) / 0.14);
		background: rgb(14 10 11 / 0.94);
		backdrop-filter: blur(8px);
		font-size: 13px;
		color: var(--color-text-soft);
	}

	.pvh__title {
		margin: 0 0 8px;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent-soft);
	}

	.pvh__row {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 3px 0;
		cursor: pointer;
	}

	.pvh__row input {
		accent-color: rgb(var(--shade-bright));
	}

	.pvh__go {
		display: flex;
		gap: 12px;
		margin-top: 8px;
		font-size: 12px;
	}

	.pvh__go a {
		color: var(--color-accent-soft);
	}
</style>
