---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import SideNav from "../components/SideNav.astro";
import PlaceholderSections from "../components/PlaceholderSections.astro";
import Footer from "../components/Footer.astro";
import { throneAvifSrcset, throneSizes } from "../components/hero-image";

// Start fetching the hero photo straight away, alongside the fonts, instead of when the parser
// reaches it.
const throneSrcset = await throneAvifSrcset();
---

<BaseLayout>
	<link
		slot="head"
		rel="preload"
		as="image"
		type="image/avif"
		imagesrcset={throneSrcset}
		imagesizes={throneSizes}
		fetchpriority="high"
	/>
	<Header />
	<SideNav />
	<main>
		<Hero />
		<About />
		<PlaceholderSections />
	</main>
	<Footer />
</BaseLayout>

<script>
	import { animation } from "../site.config";
	import { setupPaging } from "../scripts/sections";

	// One section per screen, with a smooth glide between them.
	setupPaging(animation.paging);
</script>
