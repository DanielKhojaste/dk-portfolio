{
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		},
		{
			"files": ["*.md", "*.yml", "*.yaml"],
			"options": {
				"useTabs": false
			}
		}
	],
	"useTabs": true,
	"tabWidth": 2,
	"semi": true,
	"singleQuote": false,
	"printWidth": 100
}
